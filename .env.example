# RiskSynth AI - environment variables (copy to .env; never commit .env)
# Paths, seeds, rules and thresholds live in configs/*.yaml, not here.

# Optional: write generate_synthetic.py outputs somewhere other than data/synthetic/
# RISKSYNTH_OUTPUT_DIR=./data/synthetic

# Optional (Windows): force UTF-8 console I/O. Not required - all CLI output is ASCII-safe.
# PYTHONIOENCODING=utf-8

# Streamlit reads STREAMLIT_* variables natively
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
